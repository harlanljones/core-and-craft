[Unit]
Description=LifeQuest: archive Monkeytype results
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# MONKEYTYPE_APE_KEY=... in a 0600 file. Or drop this line and use
# LoadCredentialEncrypted=monkeytype:%h/.config/lifequest/monkeytype.cred
EnvironmentFile=%h/.config/lifequest/monkeytype.env
Environment=LQ_DATA=%h/life LQ_STATE=%h/.local/state/lifequest
# Installed binary, never `go run`: mise's Go is not on the unit's PATH.
ExecStart=%h/.local/bin/lq mt pull
ExecStartPost=%h/.local/bin/lq snapshot
NoNewPrivileges=yes
PrivateTmp=yes
